{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Android USB Prep",
  "version": "1.0.0",
  "identifier": "win.redredwh1ne.androidusbprep",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Android USB Prep",
        "width": 860,
        "height": 900,
        "minWidth": 640,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Prepare USB sticks for Android TV boxes",
    "longDescription": "Formats a USB stick for Android TV / OTT boxes, creates the standard Android folders and copies + verifies APK files.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
